# Copy these placeholders into your local environment or hosting dashboard.
DJANGO_SETTINGS_MODULE=ICT_CLUB.production_settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-real-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-real-domain.example
PUBLIC_BASE_URL=https://your-real-domain.example
DJANGO_SECURE_SSL_REDIRECT=true

# Leave DATABASE_URL unset to use SQLite, or configure a PostgreSQL URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

ICT_CLUB_EMAIL_HOST=smtp.gmail.com
ICT_CLUB_EMAIL_PORT=587
ICT_CLUB_EMAIL_USER=
ICT_CLUB_EMAIL_PASSWORD=
ICT_CLUB_EMAIL_USE_TLS=true

# Set these only when creating a missing leader account for the first time.
# Existing passwords are not reset by page visits or deployments.
ICT_CLUB_INITIAL_PASSWORD_CODESTAR=
ICT_CLUB_INITIAL_PASSWORD_PATRON=
ICT_CLUB_INITIAL_PASSWORD_SECRETARY=
ICT_CLUB_INITIAL_PASSWORD_SPEAKER=
ICT_CLUB_INITIAL_PASSWORD_TREASURER=
ICT_CLUB_INITIAL_PASSWORD_PROJECTSMANAGER=
ICT_CLUB_INITIAL_PASSWORD_MOBILISER=
